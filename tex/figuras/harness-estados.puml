@startuml
' O SVG contém o ajuste manual de Baseline à esquerda da seta; preserve-o ao regenerar.
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam stateFontSize 16
skinparam ArrowFontSize 14
hide empty description
state "Geração direta" as direta
state "Geração de testes" as testes
state "Implementação com pytest" as codigo
state "Avaliação externa" as avaliacao
[*] --> direta : Baseline
[*] --> testes : TDD
direta --> direta : nova tentativa
testes --> testes : ajustar testes
testes --> codigo : testes fixados
codigo --> codigo : falha no pytest / corrigir código
direta --> avaliacao : etapa encerrada
codigo --> avaliacao : etapa encerrada
avaliacao --> [*] : resultado registrado
@enduml
