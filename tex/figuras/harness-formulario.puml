@startuml
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
top to bottom direction
abstract class Harness
class HarnessDireto
class HarnessTDD
class Requisito
class Projeto
class Alvo
abstract class Etapa
class Agente
class Avaliador
class Resultado
class Trace
Harness <|-- HarnessDireto
Harness <|-- HarnessTDD
Harness --> Requisito
Harness --> Projeto
Projeto --> Alvo
Harness ..> Etapa : executa
Etapa --> Agente
Harness ..> Avaliador : avaliação final
Harness ..> Resultado : RUN.log
Harness --> Trace : trace.jsonl
@enduml
