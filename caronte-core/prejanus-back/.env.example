APP_NAME=prejanus
APP_ENV=local
APP_VERSION=''
# Credentials must match root .env: PREJANUS_USER, PREJANUS_PASSWORD, PREJANUS_DB
DB_CONNECTION_STRING=postgresql+psycopg://caronte_prejanus:caronte_prejanus@db:5432/caronte_prejanus
# Credentials must match root .env: FORMS_READER, FORMS_READER_PASSWORD, FORMS_DB
DB_CONNECTION_STRING_FORMS=postgresql+psycopg://caronte_forms_reader:caronte_forms_reader@db:5432/caronte_forms

BASE_URL=http://localhost

SMTP_SERVER=smtp
SMTP_PORT=25
SMTP_USER=seu_email@example.com
SMTP_PASSWORD=''
FROM_EMAIL=seu_email@example.com
#SMTP_USE_TLS=SMTP_USE_TLS

SECRET_KEY=SECRET_KEY

SENHAUNICA_CONSUMER_KEY=
SENHAUNICA_CONSUMER_SECRET=

SENHAUNICA_OAUTH_HOST=https://uspdigital.usp.br
SENHAUNICA_ACCESS_TOKEN_RESOURCE=wsusuario/oauth/access_token
SENHAUNICA_AUTHORIZE_URL=wsusuario/oauth/authorize
SENHAUNICA_REQUEST_TOKEN_RESOURCE=wsusuario/oauth/request_token
SENHAUNICA_CALLBACK_ID=3

# ── Local dev auth bypass (only active when APP_ENV=local) ──────────────────
# Set to the ID of an existing user row in the database.
DEV_USER_ID=1
