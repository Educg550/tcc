#: app/templates/form/create.html:5
msgid ""
"Este schema JSON define a estrutura, tipos e validações dos campos que "
"devem compor o formulário. Use-o como referência para construir um "
"formulário que atenda exatamente às regras especificadas."
msgstr ""
"This JSON schema defines the structure, types, and validations of the "
"fields that should make up the form. Use it as a reference to build a "
"form that adheres precisely to the specified rules."

#: app/templates/form/create.html:7
msgid "Clique aqui para acessar o JSON Schema"
msgstr "Click here to access the JSON Schema"

#: app/templates/form/create.html:9
msgid "O que fazer:"
msgstr "What to do:"

#: app/templates/form/create.html:15
#, python-format
msgid ""
"%(start_b)sAnalise o schema JSON%(end_b)s observe os campos dentro da "
"propriedade %(start_code_i)s\"properties\"%(end_code_i)s, seus tipos "
"(%(start_code_ii)sstring%(end_code_ii)s, "
"%(start_code_iii)snumber%(end_code_iii)s, "
"%(start_code_iv)sboolean%(end_code_iv)s, etc.), títulos, descrições e "
"restrições."
msgstr ""
"%(start_b)sAnalyze the JSON schema%(end_b)s and note the fields inside "
"the %(start_code_i)s\"properties\"%(end_code_i)s property, their types "
"(%(start_code_ii)sstring%(end_code_ii)s, "
"%(start_code_iii)snumber%(end_code_iii)s, "
"%(start_code_iv)sboolean%(end_code_iv)s, etc.), titles, descriptions, and"
" constraints."

#: app/templates/form/create.html:26
#, python-format
msgid ""
"%(start_b)sImplemente validações%(end_b)s conforme descritas no schema "
"(formatos regex em %(start_code)svalidation%(end_code)s)."
msgstr ""
"%(start_b)sImplement validations%(end_b)s as described in the schema "
"(regex formats in %(start_code)svalidation%(end_code)s)."

