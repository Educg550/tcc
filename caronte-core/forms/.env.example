# Credentials must match root .env: FORMS_USER, FORMS_PASSWORD, FORMS_DB
POSTGRES_HOST=db
POSTGRES_DB=caronte_forms
POSTGRES_USER=caronte_forms
POSTGRES_PASSWORD=caronte_forms
POSTGRES_PORT=5432

SMTP_SERVER=smtp
SMTP_PORT=25
SMTP_USER=seu_email@example.com
SMTP_PASSWORD=
FROM_EMAIL=seu_email@example.com
#SMTP_USE_TLS=SMTP_USE_TLS

BASE_URL=http://localhost

# senhaunica
SENHAUNICA_CONSUMER_KEY=
SENHAUNICA_CONSUMER_SECRET=

SENHAUNICA_OAUTH_HOST=https://uspdigital.usp.br
SENHAUNICA_REQUEST_TOKEN_RESOURCE=wsusuario/oauth/request_token
SENHAUNICA_AUTHORIZE_URL=wsusuario/oauth/authorize
SENHAUNICA_ACCESS_TOKEN_RESOURCE=wsusuario/oauth/access_token
SENHAUNICA_CALLBACK_ID=3

# python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY=SECRET_KEY

BABEL_TRANSLATION_DIRECTORIES=translations
BABEL_DEFAULT_LOCALE=pt

# if this environment variable is set then it is active
# check using `--profile clamav` in docker compose
#USE_CLAMAV=

REDIS_URL=redis://redis:6379/0

# used to store data on a mounted volume
DOCKER_DATA_PATH=./docker

# ── Local dev auth bypass ────────────────────────────────────────────────────
# Set to the email of an existing user row in the database.
DEV_USER_EMAIL=dev@example.com
